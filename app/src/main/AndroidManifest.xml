<?xml version="1.0" encoding="utf-8"?>
<!-- Autor: jjcampac - IA: cline -->


<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos mínimos: red + servicio en primer plano (mediaPlayback) + notificaciones -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibración háptica al iniciar el arrastre en Favoritas (permiso normal, se otorga en instalación).
         Obligatorio en Android 12+ para Vibrator.vibrate(); sin él la app crashea con SecurityException. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".EterApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Eter">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Eter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Servicio de medios en segundo plano (se completa en Fase 2) -->
        <service
            android:name=".player.service.RadioMediaSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>