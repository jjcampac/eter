<!--
    Declaración para Android Auto.

    Eter se anuncia como app de *audio* ("media"): Android Auto usa la tarjeta
    multimedia y el navegador del sistema, sin pantallas propias. No requiere
    permisos ni componentes adicionales en el manifiesto.
-->
<automotiveApp>
    <uses name="media" />
</automotiveApp>
