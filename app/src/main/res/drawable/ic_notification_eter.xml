<!-- Icono pequeño de la notificación (barra de estado y esquina de la tarjeta
     multimedia). Versión monócroma y a 24 dp del logo de la app: el punto
     emisor y sus ondas, redibujadas con trazos gruesos para que se lean a este
     tamaño. El icono del launcher es adaptativo (108 dp y trazos finos) y a
     24 dp solo se apreciaba el punto central. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Punto emisor -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,5.5m-2.1,0a2.1,2.1 0 1,1 4.2,0a2.1,2.1 0 1,1 -4.2,0" />
    <!-- Onda interior -->
    <path
        android:fillColor="#00000000"
        android:pathData="M7.5,9.5a6,6 0 0,0 9,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
    <!-- Onda intermedia -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5,12.5a9.5,9.5 0 0,0 14,0"
        android:strokeAlpha="0.75"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
    <!-- Onda exterior -->
    <path
        android:fillColor="#00000000"
        android:pathData="M2.5,15.5a13,13 0 0,0 19,0"
        android:strokeAlpha="0.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.9" />
</vector>
