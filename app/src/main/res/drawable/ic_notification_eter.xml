<?xml version="1.0" encoding="utf-8"?>
<!-- Autor: jjcampac - IA: cline -->
<!--
    Icono pequeño de la notificación: esquina superior izquierda de la tarjeta
    multimedia, barra de estado y tarjeta de Android Auto.

    Es una versión del logo de la app (ic_launcher_foreground) redibujada a
    24 dp: mismo trazado (emisor con antena y tres ondas concéntricas
    desplazadas), pero con los trazos engrosados para que se lean a ese tamaño.
    Con el grosor original (3 sobre un lienzo de 108) el sistema lo reduce a
    menos de 1 dp y solo se aprecia el punto central.

    El viewport se mantiene en 108 para conservar las coordenadas del logo; el
    vector se escala solo a sus 24 dp. Android tiñe el icono de blanco, así que
    aquí solo importan la forma y las transparencias.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ondas del logo: anillos concéntricos desplazados hacia abajo -->
    <path
        android:pathData="M54,54a22,22 0 1,0 0,44a22,22 0 1,0 0,-44"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeAlpha="0.95" />
    <path
        android:pathData="M54,54a34,34 0 1,0 0,68a34,34 0 1,0 0,-68"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeAlpha="0.70" />
    <path
        android:pathData="M54,54a46,46 0 1,0 0,92a46,46 0 1,0 0,-92"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeAlpha="0.45" />
    <!-- Emisor central -->
    <path
        android:pathData="M54,44a10,10 0 1,0 0,20a10,10 0 1,0 0,-20"
        android:fillColor="#FFFFFFFF" />
    <!-- Antena: mástil y punto superior -->
    <path
        android:pathData="M54,36v-10"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10" />
    <path
        android:pathData="M54,26a3,3 0 1,0 0,6a3,3 0 1,0 0,-6"
        android:fillColor="#FFFFFFFF" />
</vector>
